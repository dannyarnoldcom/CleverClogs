            <ui:VisualElement name="GenerateContainer" class="options" style="padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px; border-left-color: rgba(0, 0, 0, 0.21); border-right-color: rgba(0, 0, 0, 0.21); border-top-color: rgba(0, 0, 0, 0.21); border-bottom-color: rgba(0, 0, 0, 0.21); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; background-color: rgba(0, 0, 0, 0.2); min-height: 50px;">
