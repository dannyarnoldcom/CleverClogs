    <ui:VisualElement name="HeaderTextContainer" class="header">
        <ui:Label tabindex="-1" text="DADCTools Clever Clogs" display-tooltip-when-elided="true" name="Header" class="header" />
    </ui:VisualElement>
    <ui:VisualElement name="OptionsContainer" class="options_container" style="flex-grow: 1; flex-direction: column; -unity-text-outline-color: rgb(0, 0, 0);">
        <ui:VisualElement name="ScanContainer" class="options" style="border-left-color: rgba(0, 0, 0, 0.67); border-right-color: rgba(0, 0, 0, 0.67); border-top-color: rgba(0, 0, 0, 0.67); border-bottom-color: rgba(0, 0, 0, 0.67); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px; background-color: rgba(0, 0, 0, 0.2); min-height: 50px;">
            <ui:Label tabindex="-1" text="Scan project for UXML" display-tooltip-when-elided="true" />
            <ui:Button text="Scan" display-tooltip-when-elided="true" name="ScanButton" class="buttonface" />
        </ui:VisualElement>
        <ui:VisualElement name="DropdownContainer" class="hidden options" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0);">
            <ui:DropdownField label="File" index="-1" name="PathsDropdown" style="width: 100%;" />
        </ui:VisualElement>
        <ui:VisualElement name="ResultsContainer" class="hidden" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
