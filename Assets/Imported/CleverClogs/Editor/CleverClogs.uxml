<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Template name="UXMLElementTreeView" src="project://database/Assets/Imported/CleverClogs/Editor/Helpers/UXMLElementTreeView.uxml?fileID=9197481963319205126&amp;guid=30a61e229bdc75941b9384bc8dd81f1e&amp;type=3#UXMLElementTreeView" />
