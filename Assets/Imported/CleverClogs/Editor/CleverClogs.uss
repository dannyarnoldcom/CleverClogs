.body_container {
}

.header {
    -unity-text-align: upper-center;
    font-size: 24px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.header_container {
    font-size: 24px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.options_container {
    flex-direction: row;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 9px;
    padding-bottom: 9px;
}

.options {
    flex-grow: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    flex-wrap: nowrap;
    width: 100%;
    justify-content: space-between;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.buttonface {
    width: 75px;
    height: 35px;
}

.hidden {
    display: none;
}

