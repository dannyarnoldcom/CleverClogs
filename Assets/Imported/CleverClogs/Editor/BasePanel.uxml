<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="CleverClogs.uss" />
    <ui:VisualElement name="StatusContainer" class="status_container">
        <uie:Toolbar style="flex-direction: row; justify-content: flex-end; background-color: rgb(96, 96, 96);">
            <ui:Label tabindex="-1" display-tooltip-when-elided="true" name="StatusText" style="min-width: 250px; padding-left: 3px; padding-right: 0; position: absolute; left: 0; padding-top: 3px;" />
            <uie:ToolbarMenu tabindex="-1" display-tooltip-when-elided="true" name="ToolbarMenu" />
        </uie:Toolbar>
    </ui:VisualElement>
    <ui:VisualElement name="BodyContainer" class="body_element" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); padding-top: 4px;" />
</ui:UXML>
