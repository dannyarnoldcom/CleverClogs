<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="DialogueWindow.uss" />
    <ui:VisualElement name="ControlsContainer" class="window_control" style="flex-grow: 1; background-color: rgb(118, 117, 117); position: absolute; top: 0; flex-direction: row; justify-content: flex-end; width: 100%;">
        <ui:Label tabindex="-1" text="Window Title" display-tooltip-when-elided="true" name="TitleLabel" style="position: absolute; left: 0;" />
        <ui:Button text="X" display-tooltip-when-elided="true" name="CloseButton" class="buttonface window_control" />
    </ui:VisualElement>
    <ui:VisualElement name="ContentContainer" class="body_element" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); padding-top: 4px;" />
</ui:UXML>
